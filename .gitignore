# --- Cached upstream data (regenerated by scripts/fetch_data.py / server warm-up) ---
# The cache holds the raw audit trail of every API response (up to ~270 MB,
# incl. a 239 MB UCDP CSV). It is NOT committed: it is re-fetched on demand.
cache/*
!cache/.gitkeep

# Runtime / analyst working dir
data/*
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editor / OS / local tooling
.DS_Store
.claude/
.idea/
.vscode/
*.swp
